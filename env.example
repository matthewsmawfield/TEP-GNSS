# TEP-GNSS Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# GCP CONFIGURATION (Required for GCP deployment)
# =============================================================================
GCP_PROJECT_ID=your-project-id-here
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=your-instance-name-here

# =============================================================================
# ANALYSIS CONFIGURATION (Optional - uses defaults if not set)
# =============================================================================

# Core Analysis Parameters
# TEP_BINS=40
# TEP_MAX_DISTANCE_KM=13000.0
# TEP_BOOTSTRAP_ITER=5000
# TEP_NULL_ITERATIONS=20

# Processing Parameters
# TEP_WORKERS=14
# TEP_MEMORY_LIMIT_GB=8.0
# TEP_MAX_PARALLEL_DOWNLOADS=14

# Date Range
# TEP_DATE_START=2023-01-01
# TEP_DATE_END=2025-06-30

# Feature Flags
# TEP_PROCESS_ALL_CENTERS=1
# TEP_ENABLE_JACKKNIFE=1
# TEP_ENABLE_ANISOTROPY=1
# TEP_ENABLE_TEMPORAL=1

# =============================================================================
# ADVANCED CONFIGURATION (Optional)
# =============================================================================

# Network Settings
# TEP_NETWORK_TIMEOUT=30
# TEP_DOWNLOAD_TIMEOUT=60

# Statistical Parameters
# TEP_MIN_BIN_COUNT=50
# TEP_MIN_BINS_FOR_FIT=5
# TEP_CORRELATION_LENGTH_INITIAL_GUESS=3000

# Validation Parameters
# TEP_LOSO_MAX_STATIONS=50
# TEP_LODO_MAX_DAYS=100
# TEP_MONTHLY_CV_FOLDS=10

# =============================================================================
# NOTES
# =============================================================================
# 1. Only GCP_* variables are required for GCP deployment
# 2. All other variables have sensible defaults in scripts/utils/config.py
# 3. Boolean values: use 1/0, true/false, yes/no, on/off
# 4. For lists: use comma-separated values
# 5. See scripts/utils/config.py for complete parameter documentation
