{
  "jobDefinitionName": "tep-gnss-analysis",
  "type": "container",
  "containerProperties": {
    "image": "YOUR_ACCOUNT_ID.dkr.ecr.YOUR_REGION.amazonaws.com/tep-gnss:latest",
    "vcpus": 96,
    "memory": 300000,
    "jobRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/tep-gnss-batch-role",
    "environment": [
      {
        "name": "TEP_WORKERS",
        "value": "96"
      },
      {
        "name": "TEP_MEMORY_LIMIT_GB",
        "value": "300"
      },
      {
        "name": "TEP_BOOTSTRAP_ITER",
        "value": "2000"
      },
      {
        "name": "AWS_DEFAULT_REGION",
        "value": "us-east-1"
      }
    ],
    "mountPoints": [
      {
        "sourceVolume": "efs-storage",
        "containerPath": "/app/data",
        "readOnly": false
      }
    ],
    "volumes": [
      {
        "name": "efs-storage",
        "efsVolumeConfiguration": {
          "fileSystemId": "fs-YOUR_EFS_ID",
          "rootDirectory": "/tep-gnss-data"
        }
      }
    ],
    "command": [
      "python",
      "/app/scripts/clean_run_full_pipeline.py"
    ],
    "resourceRequirements": [
      {
        "type": "VCPU",
        "value": "96"
      },
      {
        "type": "MEMORY",
        "value": "300000"
      }
    ]
  },
  "retryStrategy": {
    "attempts": 3
  },
  "timeout": {
    "attemptDurationSeconds": 14400
  }
}
